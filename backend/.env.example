PORT=4000
NODE_ENV=development

# PostgreSQL (Cloud SQL)
DATABASE_URL=postgresql://user:password@localhost:5432/axisandbloom

# Test database isolation (2026-09-16) — same instance, via the same proxy, a
# separate database so `npm test` can never touch prod. vitest.config.ts
# refuses to run anything whose database name doesn't end in '_test'.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/axisandbloom_test

# Firebase Admin (service account JSON as string, or path)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Shopify (roastery store)
SHOPIFY_STORE_DOMAIN=your-roastery.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
SHOPIFY_ADMIN_TOKEN=your-admin-access-token

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Resend (transactional email — quiz-complete archetype card, password reset)
# Unset = transactional sends silently no-op (see resendEmail.ts's RESEND_ENABLED)
RESEND_API_KEY=re_...
RESEND_FROM=Axis & Bloom <hello@axisandbloomcoffee.com>
RESEND_REPLY_TO=hello@axisandbloomcoffee.com

# Catalog Blueprint (brief 2) — 'true' turns placeCoffee/moveCoffee's D6 spec-band
# and descriptor-family warnings into a hard 409 SPEC_VIOLATION instead of the
# default warn+record (a placementNote still saves it). Off by default.
CATALOG_SPEC_HARD_GATE=false
