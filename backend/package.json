{
  "name": "axis-and-bloom-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node -e \"import('./src/db/migrate.js').then(m => m.migrate())\"",
    "catalog:import": "tsx src/scripts/catalogImport.ts",
    "lint:catalog": "node scripts/lint-catalog.mjs",
    "lint:retention": "node scripts/lint-retention.mjs",
    "lint:customer": "node scripts/lint-customer.mjs",
    "test": "vitest run",
    "test:db:refresh": "node scripts/refresh-test-db.mjs"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.1.0",
    "pg": "^8.23.1",
    "resend": "^6.31.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  }
}
