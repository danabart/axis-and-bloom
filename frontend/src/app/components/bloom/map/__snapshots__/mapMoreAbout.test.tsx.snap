exports[`the Bloom page’s panel is unchanged (no mapProfile) > renders the same markup as before Ella map 13 1`] = `"<div id="p" class="bf-profile" data-testid="field-reveal"><div class="bf-pcols"><div class="bf-pcol"><span class="ab-caps ab-titled" style="align-self: flex-start;">In the roaster’s words</span><p class="bf-story">Chocolate and almond.</p><div class="flex flex-wrap gap-1.5 mt-1"><span class="px-2 py-0.5 rounded bg-stone-100 text-stone-400 text-[10.5px] uppercase tracking-[.12em]">Espresso</span></div></div><div class="bf-pcol"><span class="ab-caps ab-titled" style="align-self: flex-start;">Cupping profile</span><div class="bf-cp" data-testid="field-bars"><div style="display: contents;"><span class="bf-cl">Body</span><span class="bf-ct" role="img" aria-label="Body: 5 to 9 of 15, from light to heavy"><i class="bf-track"></i><i class="bf-seg" style="left: 33.33333333333333%; width: 26.666666666666668%;"></i><span class="bf-ce" aria-hidden="true"><span>light</span><span>heavy</span></span></span></div></div><details class="bf-noteswheel"><summary><span class="ab-caps">See the notes wheel</span></summary><div><p class="mb-[18px]" style="font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: rgb(123, 127, 128); font-weight: 400;">Signature notes</p><div><p class="text-[15px]" style="color: rgb(69, 71, 74); font-weight: 400; line-height: 1.5;">Almond</p></div></div></details></div></div><div class="bf-pfoot"><div class="bf-plinks"><button type="button" class="ab-caps bf-ulink">Compare with the neighbour ↗</button></div></div></div>"`;
