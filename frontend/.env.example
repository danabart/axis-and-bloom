VITE_API_URL=http://localhost:4000
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# C6 -- Firebase App Check (reCAPTCHA v3 site key, public by design)
VITE_RECAPTCHA_APPCHECK_SITE_KEY=6LcoeHwtAAAAANcHTyuClbWwFi6Q3jmEv7szavxv

# Commerce 1 -- Stripe publishable key for Embedded Checkout (public by design, pk_test_ until Commerce brief 4)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Checkout UX 1 -- bare hostname every visitor is sent to on load; leave empty locally (no redirect)
VITE_CANONICAL_HOST=
